
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model organizations {
  id                String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String             @db.VarChar(255)
  status            String             @default("active") @db.VarChar(20)
  created_at        DateTime           @default(now()) @db.Timestamp(6)
  updated_at        DateTime           @default(now()) @db.Timestamp(6)
  ai_settings       ai_settings?
  leads             leads[]
  properties        properties[]
  users             users[]
  visitors          visitors[]
  whatsapp_sessions whatsapp_sessions?
  property_matches property_matches[]
}

model ai_settings {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String        @unique @db.Uuid
  welcome_message         String?
  qualification_questions Json?         @db.Json
  booking_enabled         Boolean       @default(true)
  created_at              DateTime      @default(now()) @db.Timestamp(6)
  updated_at              DateTime      @default(now()) @db.Timestamp(6)
  organizations           organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model conversations {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id      String      @db.Uuid
  property_id     String?     @db.Uuid
  started_at      DateTime    @default(now()) @db.Timestamp(6)
  last_message_at DateTime    @default(now()) @db.Timestamp(6)
  properties      properties? @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitors        visitors    @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages        messages[]
}

model leads {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  visitor_id      String        @db.Uuid
  property_id     String?       @db.Uuid
  status          String        @default("new") @db.VarChar(50)
  score           Int?
  budget          Decimal?      @db.Decimal(14, 2)
  notes           String?
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  Visit           Visit[]
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  properties      properties?   @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitors        visitors      @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  desired_city String? @db.VarChar(100)
  bedrooms     Int?
  property_matches property_matches[]
}

model messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_type     String        @db.VarChar(20)
  content         String
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model properties {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String               @db.Uuid
  title              String               @db.VarChar(255)
  description        String?
  property_type      String               @db.VarChar(50)
  listing_type       String               @db.VarChar(50)
  price              Decimal              @db.Decimal(14, 2)
  country            String               @db.VarChar(100)
  city               String               @db.VarChar(100)
  address            String?
  bedrooms           Int?
  bathrooms          Int?
  area               Decimal?             @db.Decimal(10, 2)
  status             String               @default("available") @db.VarChar(50)
  metadata           Json?                @db.Json
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  conversations      conversations[]
  leads              leads[]
  Visit              Visit[]
  organizations      organizations        @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  property_documents property_documents[]
  property_images    property_images[]
  property_matches   property_matches[]
}

model property_images {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id   String     @db.Uuid
  image_url     String
  display_order Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  properties    properties @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model property_documents {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id String     @db.Uuid
  content     String
  chunk_index Int        @default(0)
  metadata    Json?      @db.Json
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @db.Timestamp(6)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model property_images {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id   String     @db.Uuid
  image_url     String
  display_order Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  properties    properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id                     String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id        String?           @db.Uuid
  first_name             String            @db.VarChar(255)
  last_name              String            @db.VarChar(255)
  email                  String            @unique @db.VarChar(255)
  password_hash          String
  token_hash             String?
  phone                  String?           @db.VarChar(50)
  role                   String            @default("owner") @db.VarChar(20)
  created_at             DateTime          @default(now()) @db.Timestamp(6)
  updated_at             DateTime          @default(now()) @db.Timestamp(6)
  reset_token            String?
  reset_token_expires_at DateTime?         @db.Timestamptz(6)
  AgentAvailability      AgentAvailability[]
  Visit                  Visit[]
  CalendarException      CalendarException[]
  organizations          organizations?    @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model visitors {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  name            String?         @db.VarChar(255)
  email           String?         @db.VarChar(255)
  phone           String?         @db.VarChar(50)
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @db.Timestamp(6)
  conversations   conversations[]
  leads           leads[]
  organizations   organizations   @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model conversations {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id      String      @db.Uuid
  property_id     String?     @db.Uuid
  started_at      DateTime    @default(now()) @db.Timestamp(6)
  last_message_at DateTime    @default(now()) @db.Timestamp(6)
  properties      properties? @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitors        visitors    @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages        messages[]
}

model messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_type     String        @db.VarChar(20)
  content         String
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model leads {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  visitor_id      String        @db.Uuid
  property_id     String?       @db.Uuid
  status          String        @default("new") @db.VarChar(50)
  score           Int?
  budget          Decimal?      @db.Decimal(14, 2)
  notes           String?
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  Visit           Visit[]
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  properties      properties?   @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitors        visitors      @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model ai_settings {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String        @unique @db.Uuid
  welcome_message         String?
  qualification_questions Json?         @db.Json
  booking_enabled         Boolean       @default(true)
  created_at              DateTime      @default(now()) @db.Timestamp(6)
  updated_at              DateTime      @default(now()) @db.Timestamp(6)
  organizations           organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model whatsapp_sessions {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @unique @db.Uuid
  session_name    String        @unique @db.VarChar(255)
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}


model AgentAvailability {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @db.Uuid
  startTime  DateTime @db.Timestamp(6)
  endTime    DateTime @db.Timestamp(6)

  user users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId, startTime])
}

model Visit {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  property_id    String   @db.Uuid
  leadId         String   @db.Uuid
  date_of_visit  DateTime @db.Timestamp(6)
  status         String   @default("PENDING")
  startAt        DateTime @db.Timestamp(6)
  endAt          DateTime @db.Timestamp(6)
  VisitStatusHistory VisitStatusHistory[]

  user     users      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  property properties @relation(fields: [property_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  lead     leads      @relation(fields: [leadId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model CalendarException {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String   @db.Uuid
  startTime      DateTime @db.Timestamp(6)
  endTime        DateTime @db.Timestamp(6)
  reason         String?

  user users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}


model VisitStatusHistory {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId   String   @db.Uuid
  status    String
  changedAt DateTime @default(now()) @db.Timestamp(6)

  visit Visit @relation(fields: [visitId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model property_matches {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  lead_id         String        @db.Uuid
  property_id     String        @db.Uuid
  match_score     Decimal?      @db.Decimal(5, 2)
  reason          String?
  created_at      DateTime      @default(now()) @db.Timestamp(6)

  organizations organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  leads         leads         @relation(fields: [lead_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  properties    properties    @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([lead_id, property_id])
}
