generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model ai_settings {
  id                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id         String        @unique @db.Uuid
  welcome_message         String?
  qualification_questions Json?         @db.Json
  booking_enabled         Boolean       @default(true)
  created_at              DateTime      @default(now()) @db.Timestamp(6)
  updated_at              DateTime      @default(now()) @db.Timestamp(6)
  organizations           organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model bookings {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  lead_id         String?           @db.Uuid
  property_id     String            @db.Uuid
  visitor_id      String            @db.Uuid
  visit_date      DateTime          @db.Timestamp(6)
  status          String            @default("pending") @db.VarChar(50)
  notes           String?
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  leads           leads?            @relation(fields: [lead_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  properties      properties        @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitors        visitors          @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  calendar_events calendar_events[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model calendar_events {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  user_id         String        @db.Uuid
  booking_id      String?       @db.Uuid
  title           String        @db.VarChar(255)
  description     String?
  start_time      DateTime      @db.Timestamp(6)
  end_time        DateTime      @db.Timestamp(6)
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  bookings        bookings?     @relation(fields: [booking_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users           users         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model conversations {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitor_id      String      @db.Uuid
  property_id     String?     @db.Uuid
  started_at      DateTime    @default(now()) @db.Timestamp(6)
  last_message_at DateTime    @default(now()) @db.Timestamp(6)
  properties      properties? @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitors        visitors    @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  messages        messages[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model leads {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String        @db.Uuid
  visitor_id      String        @db.Uuid
  property_id     String?       @db.Uuid
  status          String        @default("new") @db.VarChar(50)
  score           Int?
  budget          Decimal?      @db.Decimal(14, 2)
  notes           String?
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  updated_at      DateTime      @default(now()) @db.Timestamp(6)
  bookings        bookings[]
  organizations   organizations @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  properties      properties?   @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  visitors        visitors      @relation(fields: [visitor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model messages {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_type     String        @db.VarChar(20)
  content         String
  created_at      DateTime      @default(now()) @db.Timestamp(6)
  conversations   conversations @relation(fields: [conversation_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model organizations {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String            @db.VarChar(255)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  ai_settings     ai_settings?
  bookings        bookings[]
  calendar_events calendar_events[]
  leads           leads[]
  properties      properties[]
  users           users[]
  visitors        visitors[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model properties {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id    String               @db.Uuid
  title              String               @db.VarChar(255)
  description        String?
  property_type      String               @db.VarChar(50)
  listing_type       String               @db.VarChar(50)
  price              Decimal              @db.Decimal(14, 2)
  country            String               @db.VarChar(100)
  city               String               @db.VarChar(100)
  address            String?
  bedrooms           Int?
  bathrooms          Int?
  area               Decimal?             @db.Decimal(10, 2)
  status             String               @default("available") @db.VarChar(50)
  metadata           Json?                @db.Json
  created_at         DateTime             @default(now()) @db.Timestamp(6)
  updated_at         DateTime             @default(now()) @db.Timestamp(6)
  bookings           bookings[]
  conversations      conversations[]
  leads              leads[]
  organizations      organizations        @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  property_documents property_documents[]
  property_images    property_images[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model property_documents {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id String     @db.Uuid
  content     String
  chunk_index Int        @default(0)
  metadata    Json?      @db.Json
  created_at  DateTime   @default(now()) @db.Timestamp(6)
  updated_at  DateTime   @default(now()) @db.Timestamp(6)
  properties  properties @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model property_images {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  property_id   String     @db.Uuid
  image_url     String
  display_order Int        @default(0)
  created_at    DateTime   @default(now()) @db.Timestamp(6)
  properties    properties @relation(fields: [property_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model users {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String            @db.Uuid
  first_name      String            @db.VarChar(255)
  last_name       String            @db.VarChar(255)
  email           String            @unique @db.VarChar(255)
  password_hash   String
  token           String?
  phone           String?           @db.VarChar(50)
  role            String            @default("owner") @db.VarChar(20)
  created_at      DateTime          @default(now()) @db.Timestamp(6)
  updated_at      DateTime          @default(now()) @db.Timestamp(6)
  calendar_events calendar_events[]
  organizations   organizations     @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model visitors {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String          @db.Uuid
  name            String?         @db.VarChar(255)
  email           String?         @db.VarChar(255)
  phone           String?         @db.VarChar(50)
  created_at      DateTime        @default(now()) @db.Timestamp(6)
  updated_at      DateTime        @default(now()) @db.Timestamp(6)
  bookings        bookings[]
  conversations   conversations[]
  leads           leads[]
  organizations   organizations   @relation(fields: [organization_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}
