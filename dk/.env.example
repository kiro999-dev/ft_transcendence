# Copy this file to dk/.env  (make does it for you) and change the secrets.

# --- Database ---
POSTGRES_USER=estate
POSTGRES_PASSWORD=estate_pass
POSTGRES_DB=estateflow
POSTGRES_PORT=5432

# --- Backend ---
ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
AI_SERVICE_TOKEN=change-me-ai-token

# --- Email (forgot-password). Leave as-is if you don't need it yet ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

# --- If Docker Hub times out on your network, uncomment these two lines ---
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:17
# NODE_IMAGE=mirror.gcr.io/library/node:22-bookworm-slim
