POSTGRES_USER=estate
POSTGRES_PASSWORD=estate_pass
POSTGRES_DB=estateflow
DATABASE_URL=postgresql://estate:estate_pass@postgres:5432/estateflow

ACCESS_TOKEN_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
AI_SERVICE_TOKEN=change-me-ai-token

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
GOOGLE_EMAIL=
GOOGLE_PASSWORD=

TSC_WATCHFILE=DynamicPriorityPolling
TSC_WATCHDIRECTORY=DynamicPriorityPolling
CHOKIDAR_USEPOLLING=true

# AI and WhatsApp
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
WAHA_SESSION=default
WAHA_API_KEY=local-waha-key
WAHA_WEBHOOK_SECRET=local-webhook-secret
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=local-waha-password
WHATSAPP_SWAGGER_USERNAME=admin
WHATSAPP_SWAGGER_PASSWORD=local-waha-password

# AI knowledge database (local development)
AI_RAG_PASSWORD=local-rag-password
AI_API_TOKEN=change-me-ai-api-token
RAG_ENABLED=true
